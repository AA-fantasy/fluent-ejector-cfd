@echo off
rem Open a Fluent case (and optional data) in the GUI for manual inspection.
rem Usage:  open_case_gui.bat  "C:\path\xx.cas.h5"  ["C:\path\xx.dat.h5"]
setlocal
set FLUENT_EXE=D:\ANSYS\2024 R2\v242\fluent\ntbin\win64\fluent.exe
if exist "%FLUENT_EXE%" goto :found
for /f "delims=" %%i in ('where /r "D:\ANSYS" fluent.exe 2^>nul') do set FLUENT_EXE=%%i
:found
if "%~1"=="" (
  echo Usage: open_case_gui.bat "case.cas.h5" ["data.dat.h5"]
  exit /b 2
)
set JOU=%~dp0_open_case.jou
echo ; generated by open_case_gui.bat > "%JOU%"
echo /file/read-case "%1" >> "%JOU%"
if not "%~2"=="" echo /file/read-data "%2" >> "%JOU%"
echo /display/views/auto-scale >> "%JOU%"
"%FLUENT_EXE%" 2ddp -i "%JOU%"
endlocal